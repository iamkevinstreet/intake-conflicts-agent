# Copy to .env and fill in. Never commit .env.
#
# Which provider the model adapter uses: anthropic | openai | azure | fake
LLM_PROVIDER=fake

# Model names. The adapter looks these up in core/llm/pricing.json for cost accounting.
LLM_MODEL=claude-sonnet-4-5
LLM_JUDGE_MODEL=claude-sonnet-4-5
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Provider credentials. Only the ones for LLM_PROVIDER are needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21

# Hard stop for an evaluation run, in US dollars. The runner refuses to continue past it.
EVAL_BUDGET_USD=5.00

# Where structured logs go. One JSON object per line.
LOG_DIR=./logs

# Redact emails, phone numbers and ID-like numbers from logs. Keep this on.
LOG_REDACT=true

# Project 3 (intake agent): Microsoft Entra ID. Leave blank to use session roles for local development.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

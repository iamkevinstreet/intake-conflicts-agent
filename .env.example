# Secrets only; every other setting lives in config/settings.toml.
# Copy this file to .env and fill in what you need. Never commit .env.

# Only the key for the provider set in [llm] provider is needed.
# The default provider, fake, is the offline stand-in and needs none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=

# Microsoft Entra ID needs no secret here: the service checks tokens with the
# tenant's published signing keys. Set [auth] mode, [entra] tenant_id and
# [entra] audience in config/settings.toml instead.
